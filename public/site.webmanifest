{
  "name": "GG Empréstimos",
  "short_name": "GG Empréstimos",
  "description": "Gerencie empréstimos pessoais, parcelas, cobranças e solicitações com cálculo automático de juros e multas. Comunicação via WhatsApp integrada.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#06b6d4",
  "background_color": "#0a0a0a",
